# https://my.telegram.org → API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# session file name (gift.session is created by login.py)
SESSION=gift
# where the browser reaches this API (same origin via nginx → /api ; other origin → https://api.medal.poker/api)
PUBLIC_BASE=/api
# origins allowed to call the API from the browser (comma separated)
ALLOWED_ORIGINS=https://play.medal.poker,https://preview.medal.poker
# seconds to cache a resolved gift / a not-found answer
CACHE_TTL=300
NEG_CACHE_TTL=60
# downloaded thumbnails / animations
MEDIA_DIR=cache
